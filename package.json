{
  "name": "edusphere_backend",
  "version": "1.0.0",
  "description": "EduSphere backend — Node.js + Express + Drizzle + Mongoose",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --port 4983",
    "db:seed": "tsx src/db/postgres/seed.ts",
    "db:diagram": "node scripts/generate-schema-html.js",
    "db:diagram:watch": "node scripts/generate-schema-html.js --watch",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VINAYAK9669/EduSphere_backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/VINAYAK9669/EduSphere_backend/issues"
  },
  "homepage": "https://github.com/VINAYAK9669/EduSphere_backend#readme",
  "dependencies": {
    "@arcjet/node": "^1.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@neondatabase/serverless": "^0.10.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "pg": "^8.21.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rate-limit-redis": "^5.0.0",
    "uuid": "^14.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0"
  }
}
